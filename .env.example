# Supabase — create a project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth — create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional GitHub OAuth — create credentials at https://github.com/settings/developers
# Leave unset if you only want Google sign-in
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# NextAuth — generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=your-random-secret

# Public URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: restrict sign-in to a specific email domain
# Leave unset to allow any Google account to sign in
# ALLOWED_EMAIL_DOMAIN=yourcompany.com
