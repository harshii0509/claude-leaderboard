{
  "name": "@claude-leaderboard/widget-react",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "React renderer for Claude Leaderboard public activity widgets",
  "license": "MIT",
  "author": "harshii0509",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshii0509/claude-leaderboard"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
