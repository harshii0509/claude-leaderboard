{
  "name": "claude-leaderboard",
  "version": "0.1.0",
  "description": "A self-hosted leaderboard for tracking your team's Claude Code usage",
  "type": "module",
  "license": "MIT",
  "author": "harshii0509",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshii0509/claude-leaderboard"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "claude",
    "leaderboard",
    "ai",
    "team",
    "nextjs",
    "supabase"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:compat": "node ./scripts/dev-compat.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "typecheck": "rm -f tsconfig.tsbuildinfo && next typegen && tsc --noEmit",
    "validate:env": "node scripts/validate-env.mjs",
    "db:push": "bash ./scripts/supabase-db-push.sh",
    "leaderboard:status": "node scripts/leaderboard-admin.mjs status",
    "leaderboard:rescan": "node scripts/leaderboard-admin.mjs rescan",
    "leaderboard:rebuild": "node scripts/leaderboard-admin.mjs rebuild",
    "leaderboard:reset": "node scripts/leaderboard-admin.mjs reset"
  },
  "dependencies": {
    "@auth/supabase-adapter": "^1.11.1",
    "@supabase/supabase-js": "^2.100.0",
    "framer-motion": "^12.40.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
